#! /usr/bin/env bash

if [ "$EUID" -ne 0 ]; then
    echo "This script must be executed with sudo"
    exit 1
fi


# Every variable which is named PROJECT_ contains a path to a dir inside of the linux-config git repo
# Every variable which is named SYSTEM_ contains a path to a dir in the system

export HOME_DIRECTORY="/home/julius/"

export PROJECT_PATH="${HOME_DIRECTORY}Projects/linux-configs/"
export PROJECT_CONFIG_DIRECTORY="${PROJECT_PATH}config/"
export PROJECT_HOSTS_FILE="${PROJECT_PATH}system/hosts"
export PROJECT_BASHRC_FILE="${PROJECT_PATH}system/.bashrc"
export PROJECT_TMUX_CONF_FILE="${PROJECT_PATH}system/.tmux.conf"
export PROJECT_ALIASES_FILE="${PROJECT_PATH}system/.aliases"
export PROJECT_GITCONFIG_FILE="${PROJECT_PATH}system/.gitconfig"
export PROJECT_PROFILE_FILE="${PROJECT_PATH}system/.profile"
# export PROJECT_="${PROJECT_PATH}"

export SYSTEM_CONFIG_DIRECTORY="${HOME_DIRECTORY}.config/"
export SYSTEM_HOSTS_FILE="/etc/hosts"
export SYSTEM_TMUX_CONF_FILE="${HOME_DIRECTORY}.tmux.conf"
export SYSTEM_BASHRC_FILE="${HOME_DIRECTORY}.bashrc"
export SYSTEM_ALIASES_FILE="${HOME_DIRECTORY}.aliases"
export SYSTEM_GITCONFIG_FILE="${HOME_DIRECTORY}.gitconfig"
export SYSTEM_PROFILE_FILE="${HOME_DIRECTORY}.profile"
# export SYSTEM_="${HOME_DIRECTORY}"
